# Development overrides — loaded by `npm run dev` only, on top of .env.
#
# Production builds (`npm run build`, and therefore `npm run android:sync`)
# ignore this file and keep using the deployed API URL from .env, so shipping
# is unaffected.
#
# Point at a locally-running backend so you can test against code you haven't
# deployed yet. Run the backend with `npm run dev` in mah-notes-backend; with no
# email provider configured it prints password-reset links straight to that
# terminal, so the whole flow is testable without any email setup.
VITE_API_BASE=http://localhost:3000
