{
  "name": "mah-notes-frontend",
  "version": "2.1.4",
  "description": "MERN frontend for Mah Notes — React + Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "cap": "C:\\PROGRA~1\\nodejs\\node node_modules/@capacitor/cli/bin/capacitor",
    "android:sync": "vite build && npm run cap -- sync android",
    "android:open": "npm run cap -- open android",
    "android:build": "vite build && npm run cap -- sync android && npm run cap -- open android",
    "build:desktop": "cross-env VITE_APP_TARGET=desktop vite build",
    "desktop:dev": "cross-env VITE_APP_TARGET=desktop node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capgo/capacitor-social-login": "^8.3.22",
    "@fontsource/archivo": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@react-oauth/google": "^0.12.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.8"
  }
}
